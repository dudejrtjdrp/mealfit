{
  "expo": {
    "name": "mealing",
    "slug": "mealfit",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mealfit",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.mealing.mvp",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 매장의 메뉴를 판정해 보여드리기 위해 현재 위치가 필요해요.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "AW9XRML8T7",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F3ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.mealing.mvp",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#17A05E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "먹은 음식 사진을 골라 기록하기 위해 사진 보관함에 접근해요.",
          "cameraPermission": "먹은 음식을 사진으로 찍어 기록하기 위해 카메라를 사용해요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "말로 먹은 음식을 기록하기 위해 마이크를 사용해요.",
          "speechRecognitionPermission": "말한 내용을 글자로 바꿔 먹은 음식을 기록하기 위해 음성 인식을 사용해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 매장의 메뉴를 판정해 보여드리기 위해 현재 위치가 필요해요."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appName": "mealing"
    }
  }
}
