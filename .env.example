# 복사해서 .env 로 쓰세요. 비워두면 로컬 폴백으로 동작합니다.
# Supabase (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 카카오 로컬 API (developers.kakao.com → 앱 → REST API 키)
EXPO_PUBLIC_KAKAO_REST_KEY=
# 식단 성향 AI 분류 (없으면 규칙 기반). 앱에 키를 넣는 건 MVP 데모용 — 출시 전에는 서버(Edge Function)로 옮길 것
EXPO_PUBLIC_ANTHROPIC_API_KEY=
