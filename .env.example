# 복사해서 .env 로 쓰세요. 비워두면 로컬 폴백으로 동작합니다.
# Supabase (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 카카오 로컬 API (developers.kakao.com → 앱 → REST API 키)
EXPO_PUBLIC_KAKAO_REST_KEY=
# 식단 성향 AI 분류 (키가 없으면 규칙 기반). 앱에 키를 넣는 건 MVP 데모용 — 출시 전에는 서버(Edge Function)로 옮길 것
# 제공자: anthropic | openai (openai 는 OpenAI 호환 API — DeepSeek·Qwen 등 저가 모델도 BASE_URL 로 사용)
EXPO_PUBLIC_LLM_PROVIDER=anthropic
EXPO_PUBLIC_LLM_API_KEY=
# 비우면 anthropic → claude-haiku-4-5, openai → gpt-4o-mini
EXPO_PUBLIC_LLM_MODEL=
# openai 호환일 때만. 비우면 https://api.openai.com/v1 (예: https://api.deepseek.com/v1)
EXPO_PUBLIC_LLM_BASE_URL=
